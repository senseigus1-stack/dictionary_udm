APP_ENV=development
APP_SECRET=change-me-to-a-random-string-at-least-32-characters
DATABASE_URL=postgresql+asyncpg://udmurt:udmurt@postgres:5432/udmurt
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:8000,http://localhost:5173
DICTIONARY_PATH=/app/data/udmurt_dictionary_full.json
AUTO_MIGRATE=true
AUTO_IMPORT_DICTIONARY=true

# Telegram is optional for local web/API development.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_SECRET=change-me-bot-to-api-secret
TELEGRAM_WEBAPP_URL=http://localhost:8000
API_INTERNAL_URL=http://api:8000
